# Netlify response headers for the HIR Dispatch Academy site (this file is read by Netlify, not served).
#
# Content-Security-Policy: the page is fully self-contained (fonts and photos are inline data: URIs), so nothing
# is loaded from other servers. Inline scripts run only if their SHA-256 hash is listed in script-src.
# After editing ANY inline <script> in index.html (including the CONFIG block), run from the project root:
#     node tools/csp-hashes.mjs --write
# Netlify builds run "node tools/csp-hashes.mjs --check" and stop if the hashes are stale.
# style-src keeps 'unsafe-inline' because the approved design uses <style> blocks and style="" attributes.
# If CONFIG.formEndpoint is ever set, add that service's origin to connect-src (e.g. https://formspree.io).
#
# Strict-Transport-Security is already sent by Netlify on hirdispatchacademy.netlify.app. Once a custom domain
# is connected and serving HTTPS, confirm it is sent there too (see docs/SECURITY-AND-HOSTING.md).
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-rW7ja9sgXbWDM2E1yGeaTfZdRG9P+su4kwPgKTwwRy0=' 'sha256-wrehZUTiIPveA72QeyGvAoz/b4GJUOdDTnSKx6TLpvg=' 'sha256-96AI7H+ON9OGnoL4E4rDS0GfTAVfnsSui4MmYOSs0K8='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; manifest-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), bluetooth=(), browsing-topics=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=(), xr-spatial-tracking=()
  Cross-Origin-Opener-Policy: same-origin

/og-image.jpg
  Cache-Control: public, max-age=86400
